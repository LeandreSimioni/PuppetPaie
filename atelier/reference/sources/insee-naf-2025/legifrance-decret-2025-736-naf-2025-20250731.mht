@charset "utf-8";

.accordion-timeline li a:hover { cursor: pointer; background-image: var(--underline-img); }

.accordion-timeline .fr-accordion__btn { font-weight: 700; font-size: 1.125rem; color: var(--text-active-grey); }

.accordion-timeline .fr-accordion__btn[aria-expanded="true"] { color: var(--text-action-high-blue-france); background-color: var(--background-alt-blue-ecume); }

.accordion-timeline .fr-collapse--expanded { background-color: var(--background-alt-blue-ecume); }

.accordion-timeline .fr-accordion__btn::before { --icon-size: 1.2rem; background-color: var(--border-plain-blue-cumulus); content: ""; display: inline-block; flex: 0 0 auto; height: var(--icon-size); width: var(--icon-size); margin-left: -8px; margin-right: 16px; vertical-align: calc((.75em - var(--icon-size)) * .5); border-radius: 100%; }

.accordion-timeline .vertical-line { width: 3px; height: 100%; background: var(--border-plain-blue-cumulus); position: absolute; margin-left: 16px; }

.accordion-timeline section:first-of-type .vertical-line { margin-top: 24px; height: calc(100% - 24px); }

.accordion-timeline section:last-of-type .vertical-line { margin-top: 0px; height: 24px; }

.accordion-timeline .version-init .vertical-line { height: calc(100% - 24px); }

.accordion-timeline .version-init button.fr-accordion__btn { cursor: default; background-color: transparent; }

.accordion-timeline .version-init button.fr-accordion__btn a { background-image: none; }

.accordion-timeline .version-init button.fr-accordion__btn a:hover { cursor: pointer; background-image: var(--underline-img); }

.accordion-timeline .version-init button.fr-accordion__btn::after { display: none; }

.accordion-timeline .current-version { background-color: rgb(from var(--border-action-low-blue-ecume) r g b / 40%); }

.accordion-timeline .content-detail-timeline[aria-hidden="true"] { display: none; }

.accordion-timeline button.lgf-tree__button[aria-expanded="true"]::before { transform: rotate(0.5turn); }

.form-advanced-search #eac-container-pdcSearchArbo { position: relative; }

.search-resume-item.type-group { padding-left: 1rem; border-left: 2px dotted; }

.one-rule, .one-rule .search-select { position: relative; }

.one-rule-wrapper { display: flex; flex-direction: column; gap: 0.25rem; }

@media screen and (min-width: 48em), print {
  .one-rule-wrapper { flex-flow: row; align-items: stretch; }
}

.one-rule .search-select { position: relative; flex-grow: 1; }

@media screen and (min-width: 48em), print {
  .one-rule .search-select { flex: 0 0 14rem; max-width: 14rem; }
}

.one-rule .search-select-content { position: absolute; z-index: 11; top: 100%; left: 0px; min-width: 100%; background-color: var(--background-default-grey); filter: drop-shadow(var(--overlap-shadow)); }

.search-select-cta { display: flex; justify-content: space-between; width: 100%; text-transform: inherit; }

.search-select-cta.fr-btn--secondary { background-color: var(--background-default-grey); }

.search-select-cta .text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.one-rule .search-select-content .search-choice { display: grid; grid-template-columns: repeat(1, minmax(0px, 1fr)); gap: 1rem; }

@media screen and (min-width: 36em) {
  .one-rule .search-select-content .search-choice { grid-template-columns: repeat(2, minmax(0px, 1fr)); }
}

@media screen and (min-width: 48em) {
  .one-rule .search-select-content .search-choice { grid-template-columns: repeat(3, minmax(0px, 1fr)); }
}

.one-rule .search-select-content .fr-radio-group { display: flex; align-items: center; width: 100%; max-width: 100%; padding: 0.5rem; background-color: var(--background-default-grey); border: 1px solid var(--border-default-grey); }

.one-rule .search-select-content .fr-radio-group:has(.search-proximity) { flex-direction: column; align-items: flex-start; gap: 1rem; }

.one-rule .search-select-content .fr-radio-group:hover { background-color: var(--background-default-grey-hover); }

.one-rule .search-select-content .fr-radio-group:has(:checked) { border-color: var(--border-action-high-blue-france); }

.one-rule .search-select-content .fr-radio-group label::after { content: ""; display: block; position: absolute; top: 0px; left: 0px; width: 100%; height: 100%; z-index: 1; }

.one-rule .search-choice [class*=" fr-icon-"]::before { background-color: var(--background-active-blue-france); }

.one-rule .search-choice .fr-icon-type-codes::before { mask-image: url("../images/search/code.svg"); }

.one-rule .search-choice .fr-icon-type-lois::before { mask-image: url("../images/search/legi.svg"); }

.one-rule .search-choice .fr-icon-type-JORF::before { mask-image: url("../images/search/jorf.svg"); }

.one-rule .search-choice .fr-icon-type-circulaire::before { mask-image: url("../images/search/circ.svg"); }

.one-rule .search-choice .fr-icon-type-jurisprudence::before { mask-image: url("../images/search/constit.svg"); }

.one-rule .search-choice .fr-icon-type-collectif::before { mask-image: url("../images/search/acco.svg"); }

.one-rule .search-choice .fr-icon-type-CNIL::before { mask-image: url("../images/search/cnil.svg"); }

.one-rule .search-input { flex-grow: 1; }

.one-rule .search-select.type-and-or { text-transform: uppercase; }

@media screen and (min-width: 48em) {
  .one-rule .search-select.type-and-or { flex-basis: 5rem; max-width: 5rem; }
}

.one-rule .search-select.type-and-or .search-choice { display: flex; flex-wrap: nowrap; }

@media screen and (min-width: 48em) {
  .one-rule .search-select.type-word { flex-basis: 16.5rem; max-width: 16.5rem; }
}

.one-rule .search-select.type-word .search-select-content { max-width: 125%; }

.one-rule .search-select.type-word .search-select-content .search-choice { grid-template-columns: repeat(1, minmax(0px, 1fr)); }

@media screen and (min-width: 36em) {
  .one-rule .search-select.type-word .search-select-content .search-choice { grid-template-columns: repeat(1, minmax(0px, 1fr)); }
}

@media screen and (min-width: 48em) {
  .one-rule .search-select.type-word .search-select-content .search-choice { grid-template-columns: repeat(1, minmax(0px, 1fr)); }
}

.item-advanced-search { position: relative; }

@media screen and (min-width: 48em) {
  .item-advanced-search::before { content: ""; position: absolute; top: 0px; bottom: 0px; left: 1.5em; z-index: 0; border-left: 2px dotted rgb(216, 216, 216); }
}

@media screen and (min-width: 48em) {
  .one-rule.type-group:first-child::before { display: block; }
}

@media screen and (min-width: 48em) {
  .one-rule::before { content: ""; position: absolute; top: 1.25rem; right: 100%; z-index: 0; display: none; width: 1.25rem; border-top: 2px dotted rgb(216, 216, 216); }
}

.search-action { display: flex; flex-direction: column; gap: 1rem; }

@media screen and (min-width: 48em) {
  .search-action { flex-direction: row; padding: 0.5rem; background-color: var(--background-default-grey); border: 1px solid var(--border-default-grey); }
}

