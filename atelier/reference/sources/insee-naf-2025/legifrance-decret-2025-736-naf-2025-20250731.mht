.search-advanced-precise .search-filter-criterion { padding: 1rem; }

.search-advanced-precise .fr-grid-row .search-filter-content { height: 100%; background-color: var(--background-alt-blue-france); }

.search-advanced-precise .facet-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: space-between; align-items: center; }

.search-advanced-precise .facet-actions .fr-btn { min-width: 6.125rem; justify-content: center; }

.search-advanced-precise .facet-actions .search-confirm { display: none; }

