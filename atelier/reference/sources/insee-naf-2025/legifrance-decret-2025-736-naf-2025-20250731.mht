:root { --bf500: #000091; --w-bf500: #fff; --t-plain: transparent; --g800: #1e1e1e; --g700: #383838; --g600: #6a6a6a; --g400: #cecece; --g300: #e7e7e7; --g200: #f0f0f0; --w: #fff; --g100-g800: #f8f8f8; --focus: #2a7ffe; --rm500: #e1000f; --overlay: rgba(156, 156, 156, 0.32); --focus-z-index: 2000; }

