#tarteaucitronRoot { box-sizing: border-box; color: var(--g700); font-family: Marianne, arial, sans-serif; text-rendering: optimizespeed; -webkit-font-smoothing: antialiased; }

#tarteaucitronRoot *, #tarteaucitronRoot ::before, #tarteaucitronRoot ::after { box-sizing: inherit; }

#tarteaucitronRoot h1 { font-size: 2.75rem; line-height: 1.25; color: var(--g800); font-weight: bold; }

@media (min-width: 48em) {
  #tarteaucitronRoot h1 { font-size: 3rem; }
}

#tarteaucitronRoot h2 { font-size: 2rem; line-height: 1.25; color: var(--g800); font-weight: bold; }

